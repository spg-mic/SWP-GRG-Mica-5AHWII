{
    "tasks": {
        "pg" : "deno run -A prisma generate",
        "pv": "deno run -A prisma validate",
        "pmd": "deno run -A prisma migrate dev"
    },
    "imports": {
        "@prisma/client": "npm:@prisma/client@^6.16.2",
        "@std/assert": "jsr:@std/assert@1",
        "he": "npm:he@^1.2.0"
    },
    "fmt": {
        "indentWidth": 4,
        "lineWidth": 130,
        "singleQuote": false,
        "proseWrap": "never"
    }
}
